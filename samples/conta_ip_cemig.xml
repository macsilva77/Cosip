    <fatura>
      <!-- NumUC e NumInstalacao identificam a UC no sistema CEMIG -->
      <NumUC>8005512233</NumUC>
      <NumInstalacao>IP-08841</NumInstalacao>
      <MesReferencia>Marco/2024</MesReferencia>
      <!-- Formato ISO aqui — o extrator COSIP converte para DD/MM/AAAA -->
      <DataEmissao>2024-03-20</DataEmissao>
      <DataVencimento>2024-04-15</DataVencimento>
      <ClasseConsumo>Poder Publico - Iluminacao Publica</ClasseConsumo>
      <Modalidade>Convencional</Modalidade>
      <TensaoNominal>220V</TensaoNominal>
    </fatura>

    <medicao>
      <LeituraAnterior>31200</LeituraAnterior>
      <LeituraAtual>33045</LeituraAtual>
      <!-- CEMIG detalha ponta e fora-ponta -->
      <ConsumoPonta>310</ConsumoPonta>
      <ConsumoForaPonta>1535</ConsumoForaPonta>
      <Consumo>1845</Consumo>
      <UnidMed>kWh</UnidMed>
    </medicao>

    <tarifas>
      <!-- Tarifas homologadas ANEEL — Despacho 3.120/2024 -->
      <TarifaTE>0.44285</TarifaTE>
      <TarifaTUSD>0.43101</TarifaTUSD>
      <TarifaKWH>0.87386</TarifaKWH>
      <Bandeira>Amarela</Bandeira>
      <AdicionalBandeira>0.01874</AdicionalBandeira>
    </tarifas>

    <icms>
      <Aliquota>18.00</Aliquota>
      <BaseCalculo>1723.52</BaseCalculo>
      <Valor>310.23</Valor>
    </icms>

    <pis>
      <Aliquota>0.65</Aliquota>
      <Valor>11.68</Valor>
    </pis>

    <cofins>
      <Aliquota>3.00</Aliquota>
      <Valor>53.90</Valor>
    </cofins>

    <total>
      <vEnergia>1611.27</vEnergia>
      <vICMS>310.23</vICMS>
      <vPIS>11.68</vPIS>
      <vCOFINS>53.90</vCOFINS>
      <vOutros>0.00</vOutros>
      <vNF>1986.08</vNF>    <!-- campo usado pelo extrator COSIP como ValorTotal -->
