<?xml version="1.0" encoding="UTF-8"?>
<!--
  Leiaute XML de Conta de Energia - Iluminação Pública
  Concessionária: CEMIG Distribuição S.A. (Minas Gerais)
  Formato: Exportação direta do sistema de faturamento CEMIG (SAP IS-U)

  Diferenças em relação a Enel/CPFL:
  - Usa <nfe> / <infNF> como envelope
  - Data no formato AAAA-MM-DD (ISO 8601)
  - Consumo separado em ponta e fora-ponta
-->
<nfe versao="4.00">
  <infNF>

    <emit>
      <CNPJ>17.155.730/0001-64</CNPJ>
      <xNome>CEMIG Distribuicao S.A.</xNome>
      <xFant>CEMIG D</xFant>
      <enderEmit>
        <xLgr>AV BARBACENA</xLgr>
        <nro>1200</nro>
        <xBairro>SANTO AGOSTINHO</xBairro>
        <xMun>BELO HORIZONTE</xMun>
        <UF>MG</UF>
        <CEP>30190-131</CEP>
      </enderEmit>
    </emit>

    <dest>
      <CNPJ>18.715.128/0001-70</CNPJ>
      <xNome>PREFEITURA MUNICIPAL DE UBERLANDIA</xNome>
      <enderDest>
        <xLgr>AV FLORIANO PEIXOTO</xLgr>
        <nro>3400</nro>
        <xBairro>BRASIL</xBairro>
        <xMun>UBERLANDIA</xMun>
        <UF>MG</UF>
        <CEP>38400-104</CEP>
      </enderDest>
